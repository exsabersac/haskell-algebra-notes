cabal-version:      2.4
name:               tao-category-beginner
version:            0.1.0.0
synopsis:           Code for the beginner video 《道可道：范畴入门》
license:            MIT
build-type:         Simple

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-unused-top-binds
  build-depends:    base >=4 && <5

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  Seg1Compose
                    Seg2YouWu
                    Seg3Maybe
                    Seg4FoldUnfold
                    Seg5Functor
                    Seg6Monad

executable tao-category-beginner
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    tao-category-beginner
