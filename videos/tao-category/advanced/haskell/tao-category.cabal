cabal-version:      2.4
name:               tao-category
version:            0.1.0.0
synopsis:           Code for the video 《道可道：范畴论与 Haskell》
license:            MIT
build-type:         Simple

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-unused-top-binds
  build-depends:    base >=4 && <5

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  Seg1Dao
                    Seg2YouWu
                    Seg3Fix
                    Seg4Hylo
                    Seg5Adjunction
                    Seg6Yoneda

executable tao-category
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    tao-category
