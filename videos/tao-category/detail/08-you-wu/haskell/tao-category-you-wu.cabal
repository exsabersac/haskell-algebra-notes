cabal-version:      2.4
name:               tao-category-you-wu
version:            0.1.0.0
synopsis:           Code for advanced deep-dive ep.8 You-Wu (initial/terminal duality, products/coproducts)
license:            MIT
build-type:         Simple

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-unused-top-binds
  build-depends:    base >=4 && <5

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  YouWu

executable tao-category-you-wu
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    tao-category-you-wu
