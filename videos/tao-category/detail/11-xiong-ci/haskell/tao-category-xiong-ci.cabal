cabal-version:      2.4
name:               tao-category-xiong-ci
version:            0.1.0.0
synopsis:           Code for advanced deep-dive ep.11 Xiong-Ci (adjunctions, State, Store, lens)
license:            MIT
build-type:         Simple

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-unused-top-binds
  build-depends:    base >=4 && <5

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  XiongCi

executable tao-category-xiong-ci
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    tao-category-xiong-ci
