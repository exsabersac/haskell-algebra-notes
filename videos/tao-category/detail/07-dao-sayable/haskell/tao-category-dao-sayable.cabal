cabal-version:      2.4
name:               tao-category-dao-sayable
version:            0.1.0.0
synopsis:           Code for advanced deep-dive ep.7 Dao sayable (objects ineffable, arrows speakable)
license:            MIT
build-type:         Simple

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-unused-top-binds
  build-depends:    base >=4 && <5

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  DaoSayable

executable tao-category-dao-sayable
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    tao-category-dao-sayable
