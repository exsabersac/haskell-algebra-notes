cabal-version:      2.4
name:               tao-category-maybe-list
version:            0.1.0.0
synopsis:           Code for deep-dive ep.3 Maybe and List
license:            MIT
build-type:         Simple

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-unused-top-binds
  build-depends:    base >=4 && <5

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  MaybeList

executable tao-category-maybe-list
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    tao-category-maybe-list
