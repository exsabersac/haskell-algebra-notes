cabal-version:      2.4
name:               tao-category-dao-sheng-yi
version:            0.1.0.0
synopsis:           Code for advanced deep-dive ep.9 Dao-Sheng-Yi (initial algebras, Fix, Lambek, cata)
license:            MIT
build-type:         Simple

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-unused-top-binds
  build-depends:    base >=4 && <5

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  DaoShengYi

executable tao-category-dao-sheng-yi
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    tao-category-dao-sheng-yi
