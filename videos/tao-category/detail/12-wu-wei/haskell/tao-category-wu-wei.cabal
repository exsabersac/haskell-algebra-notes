cabal-version:      2.4
name:               tao-category-wu-wei
version:            0.1.0.0
synopsis:           Code for advanced deep-dive ep.12 Wu-Wei (Yoneda lemma, Kan extensions)
license:            MIT
build-type:         Simple

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-unused-top-binds
  build-depends:    base >=4 && <5

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  WuWei

executable tao-category-wu-wei
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    tao-category-wu-wei
