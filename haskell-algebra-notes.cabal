cabal-version:      2.4
name:               haskell-algebra-notes
version:            0.1.0.0
synopsis:           Runnable demos for F-algebra / initial algebra / Free notes
description:
  Small base-only demos aligning with docs/ — Fix, cata, Free, foldFree,
  Free ≅ Fix (Sum (Const a) f), and common functor combos.
license:            MIT
author:             exsabersac
maintainer:         exsabersac@users.noreply.github.com
category:           Education
build-type:         Simple
extra-doc-files:    README.md

common shared
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:    base >= 4.14 && < 5

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
      Algebra.Core
      InitialAlgebra.Demo
      FreeDemo.Demo
      FunctorCombo.Demo

executable algebra-demos
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    haskell-algebra-notes
